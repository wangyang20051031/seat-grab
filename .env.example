# ============================================================
# 招聘监控 - 环境变量模板（占位符，请勿填写真实值！）
# 真实凭据请在 GitHub 仓库 → Settings → Secrets and variables →
#   Actions → New repository secret 中配置，绝不会出现在代码里。
# 本地调试可复制本文件为 .env 并填值后 source，.env 已被 .gitignore 忽略。
# ============================================================

# QQ 邮箱 SMTP 推送（与抢座脚本的 Server酱 通道完全隔离，不占其额度）
QQ_MAIL_USER=your_qq_number@qq.com
QQ_MAIL_AUTH_CODE=your_smtp_auth_code_here
QQ_MAIL_TO=your_qq_number@qq.com

# 可选运行参数（不配则用默认值）
JOB_RECENT_DAYS=7
JOB_MAX_ITEMS=30
